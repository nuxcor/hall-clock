<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same rule as backup_rules.xml, for both Google
     backup and a device-to-device transfer. Only the clock address travels;
     the WebView's storage, which holds the pairing token, stays behind. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="hall-clock.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="hall-clock.xml" />
    </device-transfer>
</data-extraction-rules>
