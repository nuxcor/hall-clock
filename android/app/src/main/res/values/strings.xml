<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Hall Clock</string>
    <!-- The clock this app opens when the first-launch search finds nothing. A
         bare name, an IP, or a host:port all work.

         Prefer a Pi's static IP over its .local name if mDNS does not reach the
         phones. Two ways that happens: Android 11 and older cannot resolve
         .local at all, and — more likely here — the Pis are wired while the
         phones are on Wi-Fi, so every lookup crosses the AP's multicast
         boundary, which some APs filter. -->
    <string name="host_default">hallclock.local</string>
    <!-- The names the first launch and Change address look for, all at once.
         install.sh names the first hall hallclock and suggests hallclock-b for
         a second; halls also get numbered (hallclock-2). Order is the order the
         list is shown in. Each one that answers as a hall clock is offered by
         the name set on its setup page, so nobody types an address to find
         their own hall on a network shared with another. -->
    <string-array name="hall_candidates">
        <item>hallclock.local</item>
        <item>hallclock-2.local</item>
        <item>hallclock-3.local</item>
        <item>hallclock-4.local</item>
        <item>hallclock-b.local</item>
        <item>hallclock-c.local</item>
        <item>hallclock-d.local</item>
    </string-array>
    <string name="search_status">Looking for the hall clock…</string>
    <string name="hall_picker_title">Which hall are you in?</string>
    <string name="hall_picker_other">Another address</string>
    <string name="host_dialog_title">Clock address</string>
    <string name="host_dialog_hint">hallclock.local or 192.168.1.50</string>
    <string name="host_dialog_ok">Connect</string>
    <string name="host_dialog_cancel">Cancel</string>
    <string name="host_dialog_error">Enter a name, an IP address, or a full http:// or https:// URL.</string>
    <string name="error_title">Can\'t reach the clock</string>
    <string name="error_address">Tried %1$s</string>
    <!-- Short on purpose. This is read by someone standing at the front of a
         hall with a meeting waiting, so it names the usual cause and the one
         thing to try next, and leaves the why to whoever sets the halls up. -->
    <string name="error_body">Check that this phone is on the hall\'s Wi-Fi. If it still fails, enter the Pi\'s IP address instead.</string>
    <string name="error_retry">Retry</string>
    <string name="error_change_address">Change address</string>
    <string name="menu_reload">Reload the controller</string>
    <string name="menu_change_address">Change address</string>
    <string name="menu_close">Close app — the meeting keeps running on the hall display</string>
    <string name="menu_cancel">Cancel</string>
</resources>
